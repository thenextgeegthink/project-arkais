        "field": "year",
        "type": "quantitative",
        "title": "Year Relative to Treatment"
      },
      "y": {
        "field": "employment_index",
        "type": "quantitative",
        "title": "Employment Index (100 = Baseline)"
      },
      "color": {
        "field": "cohort",
        "type": "nominal"
      }
    }
  },

    "recommended_gate": "GATE-07",
    "weaving_archetype": "parenthetical_grounding",
    "in_prose_blueprint": "Following reform implementation, treated regions experienced an incremental {effect_pct}% employment expansion relative to synthetic controls ({fig_ref}).",
    "required_metrics": [
      "effect_pct"
    ],
    "unit_discipline": "GATE-08"
  },
  "caption_blueprint": "{prefix} {num}: {title}. Dashed vertical divider indicates policy adoption at $t=0$.",
  "spec": {
    "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
    "mark": {
      "type": "line",
      "point": true
    },

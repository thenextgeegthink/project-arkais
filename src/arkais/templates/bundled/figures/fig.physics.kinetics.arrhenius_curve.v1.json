  "id": "fig.physics.kinetics.arrhenius_curve.v1",
  "version": "1.0.0",
  "name": "Arrhenius Kinetic Rate Temperature Dissipation Curve",
  "description": "Logarithmic reaction rate versus inverse absolute temperature yielding activation energy.",
  "category": "figures",
  "discipline": "physics",
  "tags": [
    "arrhenius",
    "kinetics",
    "activation-energy",
    "chemistry",
    "thermodynamics"

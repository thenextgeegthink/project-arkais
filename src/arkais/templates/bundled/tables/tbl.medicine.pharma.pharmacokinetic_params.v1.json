  "version": "1.0.0",
  "name": "Non-Compartmental Pharmacokinetic Parameters Across Dose Cohorts",
  "description": "Peak concentration (Cmax), AUC, half-life, and oral clearance across ascending doses.",
  "category": "tables",
  "discipline": "medicine",
  "tags": [
    "pharmacokinetics",

  "caption_blueprint": "{prefix} {num}: {title}. Uncertainties correspond to expanded standard deviation ($k=2$, 95% level).",
  "spec": "\\begin{table}[t]\n\\centering\n\\small\n\\begin{tabular}{lcccc}\n\\toprule\n\\textbf{Material Specimen} & \\textbf{Density (g/cm$^3$)} & \\textbf{Modulus $E$ (GPa)} & \\textbf{Conductivity (W/m$\\cdot$K)} & \\textbf{Poisson Ratio} \\\\\n\\midrule\nTi-6Al-4V (Annealed) & $4.43 \\pm 0.02$ & $113.8 \\pm 1.2$ & $6.7 \\pm 0.3$ & $0.342$ \\\\\nInconel 718 & $8.19 \\pm 0.03$ & $205.0 \\pm 2.5$ & $11.4 \\pm 0.5$ & $0.294$ \\\\\nArkais-Alloy-X & $5.12 \\pm 0.02$ & $184.2 \\pm 1.8$ & $24.8 \\pm 0.8$ & $0.315$ \\\\\n\\bottomrule\n\\end{tabular}\n\\end{table}",
